# Generate: python -c 'import secrets;print(secrets.token_urlsafe(48))'
GATEWAY_API_KEY=REPLACE_WITH_LONG_RANDOM_TOKEN
N8N_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_TOKEN
N8N_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Must be reachable FROM gateway and Worker containers (not localhost on the NAS).
PREFECT_API_URL=http://192.168.1.10:4200/api
# Optional self-hosted Prefect HTTP Basic Auth: username:password
PREFECT_API_AUTH_STRING=
# n8n bind loopback only. Use HTTPS reverse proxy if remote access is needed.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.48.5
N8N_PORT=5678
GATEWAY_PORT=8099
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
TZ=Asia/Shanghai
# Worker / flow configuration. Empty means optional integration disabled.
PREFECT_WORK_POOL=nas-local
GITHUB_TOKEN=
GITEA_BASE_URL=
GITEA_TOKEN=
# 32+ char HMAC secret for direct /v1/webhooks/gitea. Empty disables it.
GITEA_WEBHOOK_SECRET=
COMFYUI_BASE_URL=
NOTIFY_WEBHOOK_URL=
# OpenAI-compatible local model: intentionally disabled unless set.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Example: http://service:port/healthz (trusted operator-provided URLs only)
HEALTH_URLS=
# Worker path, not NAS host disk unless explicitly mounted.
HEALTH_DISK_PATH=
# Optional: privileged host Docker socket; leave disabled by default.
DOCKER_SOCKET=
